# KOYDUM sunucu ayarları. apps/server/.env olarak kopyala; sunucu açılırken okur.
# Ortamda aynı isimde bir değişken varsa (Docker, PowerShell'de $env:PORT) o kazanır.
PORT=4000
HOST=0.0.0.0
# Verilerin (SQLite: DATA_DIR/koydum.db) ve yüklenen fotoğrafların klasörleri
DATA_DIR=./data
# Boş bırakılırsa DATA_DIR/uploads kullanılır
UPLOAD_DIR=
# Günlük yedekler DATA_DIR/backups'a yazılır, yani veritabanıyla aynı diske. Buraya OneDrive ya da
# Google Drive'daki bir klasörü yazarsan her yedeğin bir kopyası oraya da gider, PC ölse de kalır.
# Tam yolu yaz, tırnak gerekmez: BACKUP_DIR=C:\Users\Ali\OneDrive\KOYDUM yedek
BACKUP_DIR=
# Boş bırakılırsa ilk çalıştırmada otomatik üretilip DATA_DIR/secret dosyasına yazılır
JWT_SECRET=
# Sunucunun sabit internet adresi varsa yaz (https://koydum.example.com). Boş bırakırsan davet ve
# indirme bağlantıları, isteğin geldiği adresten kurulur: evde de tünelde de doğru çıkar.
PUBLIC_URL=
# Expo push için (opsiyonel). expo.dev > Access tokens
EXPO_ACCESS_TOKEN=
LOG_LEVEL=info
# Boş bırakırsan sunucu penceresine saatiyle Türkçe satırlar yazılır. json yazarsan ham JSON çıkar
# (bir log aracına vereceksen); çıktı dosyaya ya da Docker'a gidiyorsa zaten JSON'dur.
LOG_FORMAT=
# Sadece test/geliştirme: /dev/* uçlarını açar (çelıncı anında bitirme vb.)
ENABLE_DEV_ROUTES=0
